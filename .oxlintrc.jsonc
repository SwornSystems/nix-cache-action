{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/heads/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "sort-keys": "off",
    "no-ternary": "off",
    "no-magic-numbers": ["error", { "enforceConst": true, "ignore": [0, 1] }]
  }
}
